---
import { phoneNumber } from "../../data/contact";
import { github } from "../../data/contact";
import { linkedin } from "../../data/contact";
import { email } from "../../data/contact";
import { profile } from "../../data/cv";
import Section from "../ui/Section.astro";
---

<Section id="contact">
  <h2 class="text-center text-3xl font-bold text-text-light-title dark:text-text-dark-title">
    Contacto
  </h2>

  <p class="text-center max-w-xl mx-auto text-text-light-primary dark:text-text-dark-primary">
    Si te interesa mi perfil o quieres conocer más sobre mi trabajo,
    estaré encantado de conversar.
  </p>

  <div class="flex justify-center">
    <ul class="flex flex-wrap items-center justify-center gap-2">
      <li class="badge">
        {profile.location}
      </li>
      <li class="badge">
        {email.label}
      </li>
      <li class="badge">
        {phoneNumber.label}
      </li>
    </ul>
  </div>

  <div class="justify-self-center flex flex-wrap items-center justify-center gap-4 pt-4 w-fit">
    <a
      href={email.href}
      class="flex-1 btn-primary"
    >
      Enviar correo
    </a>

    <a
      href={linkedin.href}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 btn-secondary"
    >
      {linkedin.label}
    </a>

    <a
      href={github.href}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 btn-secondary"
    >
      {github.label}
    </a>
  </div>
</Section>