---
import { PROJECT_TYPES, type Project, type ProjectType } from "../../data/projects";

const { img, title, description, problem, tech, liveUrl, repoUrl, type } = Astro.props as Project;
---

<div 
  class="flex flex-col p-6 rounded-lg space-y-4 bg-background-light-secondary dark:bg-background-dark-secondary border border-dividers-light dark:border-dividers-dark"
>
  <!-- Tipo de proyecto -->
  <span
    class={`w-fit text-xs font-medium px-3 py-1 rounded-full ${PROJECT_TYPES[type].badgeClass}`}
  >
    {PROJECT_TYPES[type].label}
  </span>

  <img src={img} alt={title} class="rounded-md object-cover border border-dividers-light dark:border-dividers-dark" />

  <h3 class="font-display text-xl font-semibold text-text-light-title dark:text-text-dark-title">
    {title}
  </h3>

  <p class="text-text-light-primary dark:text-text-dark-primary">
    {description}
  </p>

  <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">
    <strong>Reto:</strong> {problem}
  </p>

  <ul class="flex flex-wrap gap-1">
    {tech.map((t: string) => (
      <li class="badge badge-basic">{t}</li>
    ))}
  </ul>

  <div class="mt-auto flex flex-wrap gap-4 pt-2">
    {liveUrl && <a href={liveUrl} class="link">Ver proyecto</a>}
    {repoUrl && <a href={repoUrl} class="link-muted">Código</a>}
  </div>
</div>
