---
import type { EducationType } from '../../data/cv';

interface Props {
  type: EducationType;
  degree: string;
  institution: string;
  period: string;
}

const { type, degree, institution, period } = Astro.props;

const typeStyles = {
  Licenciatura: "badge badge-active",
  Diplomado: "badge badge-basic",
};
---

<article class="p-6 rounded-lg border border-dividers-light dark:border-dividers-dark bg-background-light-secondary dark:bg-background-dark-secondary space-y-2 overflow-auto">
  <span class={`text-xs font-medium px-2 py-1 rounded-full ${typeStyles[type]}`}>
    {type}
  </span>

  <h3 class="text-lg font-semibold text-text-light-title dark:text-text-dark-title">
    {degree}
  </h3>

  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <p class="font-medium text-text-light-primary dark:text-text-dark-primary">
      {institution}
    </p>

    <p class="font-medium text-text-light-secondary dark:text-text-dark-secondary">
      {period}
    </p>
  </div>
</article>
