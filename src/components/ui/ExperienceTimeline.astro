---
import ExperienceCard from "../ui/ExperienceCard.astro";
import { experiences } from "../../data/experience";

const featuredExperiences = experiences.slice(0, 3);
---

<div class="relative space-y-10">
  <!-- Línea vertical -->
  <span class="absolute left-3 top-0 h-full w-px bg-dividers-light dark:bg-dividers-dark"/>

  {featuredExperiences.map(exp => (
    <div class="relative pl-10">
      {/* Punto del timeline */}
      <span class="absolute left-1.5 top-8 w-3 h-3 rounded-full bg-accent-primary"/>

      <ExperienceCard
        role={exp.role}
        company={exp.company}
        period={exp.period}
        description={exp.card.description}
        responsibilities={exp.card.responsibilities}
        tech={exp.tech}
      />
    </div>
  ))}
</div>