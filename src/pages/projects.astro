---
export const prerender = false;

import Section from "../components/ui/Section.astro";
import ProjectCard from "../components/ui/ProjectCard.astro";
import { projects, type ProjectType } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PROJECT_TYPES } from "../data/projects";

const { searchParams } = Astro.url;

const typeParam = searchParams.get("type");

const validTypes = Object.values(PROJECT_TYPES).map(t => t.value);

const activeType = validTypes.includes(typeParam as ProjectType)
  ? typeParam
  : "todos";

const filteredProjects =
  activeType === "todos"
    ? projects
    : projects.filter(p => p.type === activeType);
---

<BaseLayout 
  title="Bryan Flores | Desarrollador Frontend Jr."
  description="Desarrollador Frontend Junior enfocado en UI y UX, con experiencia en React, TypeScript y Tailwind CSS."
>
  <Section id="projects">
    <h1 class="text-3xl font-bold mb-6 text-text-light-title dark:text-text-dark-title">
      Proyectos
    </h1>

    <p class="max-w-xl mb-8 text-text-light-secondary dark:text-text-dark-secondary">
      Selección completa de proyectos que reflejan mi experiencia,
      desde soluciones reales hasta demos técnicas y proyectos personales.
    </p>

    <div class="flex flex-wrap gap-2 mb-10">
      {Object.values(PROJECT_TYPES).map(t => (
        <a 
          href={`/projects?type=${t.value}`}
          class={`badge badge-filter ${activeType === t.value ? "badge-filter-active" : ""}`}
        >
          {t.label}
        </a>
      ))}
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {filteredProjects.length > 0 ?
        filteredProjects.map(project => (
          <ProjectCard
            img={project.img}
            title={project.title}
            description={project.description}
            problem={project.problem}
            tech={project.tech}
            liveUrl={project.liveUrl}
            repoUrl={project.repoUrl}
            type={project.type}
          />
        ))
      :
        <p class="text-center font-medium text-xs text-text-light-secondary dark:text-text-dark-secondary">
          No hay proyectos para mostrar en esta categoría.
        </p>
      }
    </div>
  </Section>
</BaseLayout>