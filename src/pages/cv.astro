---
import { email, github, linkedin } from "../data/contact";
import BaseLayout from "../layouts/BaseLayout.astro";
import EducationCard from "../components/ui/EducationCard.astro";
import SkillGroupItem from "../components/ui/SkillGroupItem.astro";
import { profile } from "../data/cv";
import { education } from "../data/cv"
import { skills } from "../data/skills"
import ExperienceTimeline from "../components/ui/ExperienceTimeline.astro";
import { experiences } from "../data/experience";
---

<BaseLayout
  title="Bryan Flores | CV"
  description="Currículum profesional de Bryan Flores, Desarrollador Frontend Junior con experiencia en React, TypeScript y UI."
>
  <main>
    <article aria-labelledby="cv-title" class="max-w-5xl mx-auto px-6">

      <!-- Header del CV -->
      <header class="pt-20 pb-16 border-b border-dividers-light dark:border-dividers-dark">
        <h1 id="cv-title" class="font-display text-4xl font-bold text-text-light-title dark:text-text-dark-title">
          {profile.name}
        </h1>

        <p class="mt-2 text-lg font-medium text-text-light-secondary dark:text-text-dark-secondary">
          {profile.job}
        </p>

        <p class="mt-2 badge">
          {profile.location}
        </p>

        <!-- Summary profesional -->
        <div>
          {profile.summary.map(paragraph => (
            <p class="mt-6 max-w-3xl leading-relaxed text-text-light-primary dark:text-text-dark-primary">
              {paragraph}
            </p>
          ))}
        </div>

        <!-- Contacto -->
        <div class="mt-6 flex flex-wrap gap-4 text-sm font-medium">
          <a href={email.href} class="link">
            {email.label}
          </a>
          <a
            href={linkedin.href}
            target="_blank"
            rel="noopener noreferrer"
            class="link"
          >
            {linkedin.label}
          </a>
          <a
            href={github.href}
            target="_blank"
            rel="noopener noreferrer"
            class="link"
          >
            {github.label}
          </a>
        </div>
      </header>

      <!-- Experiencia profesional -->
      <section id="experience" class="py-16 border-b border-dividers-light dark:border-dividers-dark">
        <div class="mb-10">
          <h2 class="font-display text-3xl font-bold">
            Experiencia profesional
          </h2>
          <p class="max-w-3xl text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Experiencia desarrollando soluciones frontend, participando en la construcción, mejora y mantenimiento de aplicaciones.
          </p>
        </div>

        <ExperienceTimeline items={experiences} />
      </section>

      <section id="education" class="py-16 border-b border-dividers-light dark:border-dividers-dark">
        <div class="mb-10">
          <h2 class="font-display text-3xl font-bold">
            Formación académica
          </h2>
          <p class="max-w-3xl text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Formación técnica orientada a ingeniería de software, complementada con especialización en gestión, seguridad y transformación digital.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {education.map(item => (
            <EducationCard
              degree={item.degree}
              institution={item.institution}
              period={item.period}
              type={item.type}
            />
          ))}
        </div>
      </section>

      <section id="skills" class="py-16">
        <div class="mb-10">
          <h2 class="font-display text-3xl font-bold">
            Habilidades técnicas
          </h2>
          <p class="max-w-3xl text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Conjunto de tecnologías y prácticas aplicadas en el desarrollo de interfaces modernas, priorizando arquitectura limpia, experiencia de usuario y mantenibilidad.
          </p>
        </div>

        <div class="grid gap-12 md:grid-cols-2 items-start">
          {skills.map(group => (
            <SkillGroupItem
              title={group.title}
              description={group.description}
              items={group.items}
            />
          ))}
        </div>
      </section>

    </article>
  </main>
</BaseLayout>
